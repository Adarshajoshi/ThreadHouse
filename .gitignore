# =============================================================================
#  Secrets — DO NOT commit these
# =============================================================================
.env
.env.local
.env.*.local
backend/.env
admin/.env
frontend/.env

# =============================================================================
#  Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
*.egg-info/
*.egg
.venv/
venv/
env/
ENV/

# =============================================================================
#  Node / Vite
# =============================================================================
node_modules/
.vite/
dist/
.parcel-cache/
.next/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================================================
#  Editors / OS
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
#  Local data (regenerable)
# =============================================================================
backend/uploads/
backend/static/images/*.jpg
backend/static/images/*.jpeg
backend/static/images/*.png
backend/static/images/*.webp
backend/static/images/*.gif
!backend/static/images/.gitkeep

# Old backend that was renamed during the migration
backend_old/

# =============================================================================
#  ML — heavy artifacts that don't belong in git
# =============================================================================
backend/app/ML/datasets/
backend/app/ML/plots/
backend/app/ML/outputs_n_insights/
*.ipynb
*.csv

# Keep the trained model artifacts so the pipeline runs out-of-the-box
!backend/app/ML/artifacts/*.pkl
!backend/app/ML/artifacts/*.pt

# =============================================================================
#  Misc
# =============================================================================
*.sqlite
*.db
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
