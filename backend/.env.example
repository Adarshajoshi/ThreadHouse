# =============================================================================
#  ThreadHouse backend — environment variables
#  Copy this file to .env and fill in the blanks.
# =============================================================================

# --- Postgres (asyncpg, used by shop routers: auth/orders/analytics) ----------
DB_USER=postgres
DB_PASSWORD=
DB_NAME=mindless
DB_HOST=localhost
DB_PORT=5432

# --- Postgres (SQLAlchemy, used by intel routers) ----------------------------
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# Must point at the SAME database as above.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGEME@localhost:5432/mindless

# --- Auth secrets ------------------------------------------------------------
# Generate fresh values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Min 32 chars. Both are required at boot.
JWT_SECRET=
SECRET_KEY=

# --- LLM (optional; only used by /api/results/{id}/query and the Insights cards)
# Free key: https://console.groq.com  (no credit card)
GROQ_API_KEY=

# --- Pipeline paths ----------------------------------------------------------
UPLOAD_DIR=uploads
MODEL_DIR=app/ML/artifacts
PRODUCTS_JSON=products.json
